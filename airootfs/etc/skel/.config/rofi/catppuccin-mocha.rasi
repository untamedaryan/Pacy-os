* {
    bg:       #0a0a0a;
    bg-alt:   #1a1a1a;
    fg:       #e5e5e5;
    fg-alt:   #888888;
    accent:   #FFD700;
    urgent:   #ff5555;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: @bg;
    border: 1px solid;
   border-color: #2a2a2a;
   border-radius: 16px;
    width: 600px;
}

mainbox {
    padding: 10px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    border: 1px solid;
    border-color: #2a2a2a;
    padding: 8px 12px;
    margin: 0 0 10px 0;
    children: [prompt, entry];
}

prompt {
    color: @accent;
    padding: 0 8px 0 0;
}

entry {
    color: @fg;
}

listview {
    lines: 8;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    spacing: 8px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg-alt;
}

element selected.normal {
    background-color: transparent;
    text-color: @accent;
    border: 0px solid;
    border-color: @accent;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element-icon {
    size: 24px;
}

element-text {
    color: inherit;
    vertical-align: 0.5;
}
